{
  "name": "front-office",
  "version": "0.1.0",
  "private": true,
  "description": "프런트 오피스 - 야구 구단 경영 시뮬레이션 (PC/Steam 우선)",
  "main": "dist/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs && vite build",
    "start": "node scripts/start.mjs",
    "dev": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "test": "vitest run",
    "sim": "node scripts/build.mjs && node scripts/run-electron-node.mjs dist/cli/simulate.js",
    "test:electron": "node scripts/run-electron-node.mjs node_modules/vitest/vitest.mjs run",
    "selftest": "npm run build && node scripts/selftest.mjs",
    "calibrate": "esbuild scripts/calibrate-model.ts --bundle --platform=node --format=cjs --outfile=dist/cli/calibrate.js --log-level=warning && node dist/cli/calibrate.js",
    "validate:form": "esbuild scripts/validate-form.ts --bundle --platform=node --format=cjs --outfile=dist/cli/validate-form.js --log-level=warning && node dist/cli/validate-form.js",
    "bench:season": "esbuild scripts/bench-season.ts --bundle --platform=node --format=cjs --outfile=dist/cli/bench-season.js --log-level=warning && node dist/cli/bench-season.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "steamworks-ffi-node": "^0.11.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@3.3.7": true
  }
}
